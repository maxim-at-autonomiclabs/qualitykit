{
  "name": "qualitykit",
  "version": "0.3.0",
  "description": "Read-only SEO + AEO MCP server for Next.js — audit, AI readiness, advise-only fixes",
  "type": "module",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "qualitykit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/cf-prepare.mjs",
    "build": "npm run build -w @qualitykit/engine && tsc",
    "build:engine": "npm run build -w @qualitykit/engine",
    "publish:engine": "npm publish -w @qualitykit/engine --access public",
    "cf:deploy": "node scripts/cf-deploy.mjs",
    "deploy:web": "npm run deploy --prefix website",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build:engine && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "seo",
    "aeo",
    "nextjs",
    "cursor"
  ],
  "author": "Maxim / Autonomic Labs",
  "license": "MIT",
  "homepage": "https://qualitykit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxim-at-autonomiclabs/qualitykit.git"
  },
  "bugs": {
    "url": "https://github.com/maxim-at-autonomiclabs/qualitykit/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@qualitykit/engine": "0.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1",
    "wrangler": "^4.162.0"
  }
}
